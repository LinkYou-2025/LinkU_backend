# 이 파일을 terraform.tfvars로 복사한 뒤 콘솔에서 확인한 실제 값으로 채울 것
# (EC2 콘솔 → 인스턴스 상세에서 전부 확인 가능)

ami_id             = "ami-xxxxxxxxxxxxxxxxx"
key_name           = "linku-key"
subnet_id          = "subnet-xxxxxxxxxxxxxxxxx"
vpc_id             = "vpc-xxxxxxxxxxxxxxxxx"
# EventBridge가 상태 변화를 감지할 dev EC2 인스턴스 ID (infra/envs/dev의 instance_id output과 동일)
dev_instance_id    = "i-xxxxxxxxxxxxxxxxx"